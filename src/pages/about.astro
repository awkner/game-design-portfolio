---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { url } from '../utils/url';

const resumeHref = siteConfig.resumeUrl.startsWith('/') ? url(siteConfig.resumeUrl) : siteConfig.resumeUrl;
const tools = [
  'Unity, Unreal Engine 5, Meta Horizon Studio, Godot, Roblox Studio',
  'Blender, Maya, ZBrush, Substance Painter and Designer, Photoshop, Aseprite',
  'Git, Plastic SCM, Jira, Trello, Notion, agile/scrum',
];
---

<BaseLayout title="About" description={`About ${siteConfig.ownerName}, ${siteConfig.specialty}.`}>
  <article class="prose page">
    <h1>About</h1>
    <p>
      I'm Bruno, a game designer based in Brasília, Brazil. I have worked in game development for
      more than 13 years, on shipped indie titles and in mobile VR, mostly as a 3D and pixel artist,
      animator and art lead. Along the way I collaborated on game design, built character
      customization systems and led a team of four 3D artists.
    </p>
    <p>
      I don't have a formal Game Designer credit yet, and I'd rather say so plainly. The projects on
      this site are my design work: a systems-driven tactics roguelike, a rhythm fighting game and an
      asymmetric multiplayer game. Each page says what I decided, what was tested and what was not.
      My art, production and design history is on the <a href={url('/resume/')}>Resume</a> page.
    </p>
    <p>I'm looking for game design roles where a background in art and production helps the team.</p>
    <h2>Tools</h2>
    <ul>
      {tools.map((t) => <li>{t}</li>)}
    </ul>
    <h2>Education</h2>
    <ul>
      <li>Postgraduate degree, Digital Game Development, Centro Universitário FMU | FIAM-FAAM (2014 to 2015)</li>
      <li>Technologist degree (undergraduate), Digital Games, Centro Universitário IESB (2011 to 2014)</li>
    </ul>
    <h2>Languages</h2>
    <ul>
      {siteConfig.languages.map((l) => <li>{l}</li>)}
    </ul>
    <h2>Resume</h2>
    <p>
      <a href={url('/resume/')}>Read the resume</a> (experience, design projects, skills)
      {resumeHref && <> or <a class="button" href={resumeHref}>Download PDF (1 page)</a></>}
    </p>
    <h2>Links</h2>
    <ul class="link-row">
      <li><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
      <li><a href={siteConfig.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in new tab)</span></a></li>
      <li><a href={siteConfig.artstation} rel="noopener" target="_blank">ArtStation<span class="sr-only"> (opens in new tab)</span></a></li>
    </ul>
  </article>
</BaseLayout>
