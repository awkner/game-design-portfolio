---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/url';
import '../../styles/project-media.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const og = await getImage({ src: data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
---

<BaseLayout title={data.title} description={data.summary} image={og.src} imageAlt={data.coverAlt} imageWidth={og.attributes.width} imageHeight={og.attributes.height}>
  <article class="project">
    <p><a href={url('/#projects')}>&larr; All projects</a></p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
    <figure class="cover-fig">
      <Image src={data.cover} alt={data.coverAlt} widths={[800, 1200]} sizes="(min-width: 960px) 900px, 100vw" class="project-cover" loading="eager" />
      {data.coverCaption && <figcaption class="cover-caption">{data.coverCaption}</figcaption>}
    </figure>

    <section class="glance" aria-labelledby="glance-title">
      <h2 id="glance-title" class="sr-only">At a glance</h2>
      <dl>
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        {data.platform && data.platform.length > 0 && (
          <div><dt>Platform</dt><dd>{data.platform.join(', ')}</dd></div>
        )}
        {data.duration && (
          <div><dt>Timeline</dt><dd>{data.duration}</dd></div>
        )}
        {data.teamSize && data.teamSize > 1 && data.contribution && data.contribution.length > 0 && (
          <div><dt>What I did</dt><dd><ul class="contribution">{data.contribution.map((c) => <li>{c}</li>)}</ul></dd></div>
        )}
        <div><dt>Tools</dt><dd>{data.tools.join(', ')}</dd></div>
        {data.aiDisclosure && <div class="ai-note"><dt>AI use</dt><dd>{data.aiDisclosure}</dd></div>}
      </dl>
      {data.playUrl && <a class="button" href={data.playUrl} rel="noopener" target="_blank">Play the game<span class="sr-only"> (opens in new tab)</span></a>}
    </section>

    {data.itchEmbed && (
      <div class="media itch-embed">
        <iframe src={data.itchEmbed} title={`${data.title} playable build`} loading="lazy" allowfullscreen
          allow="autoplay; fullscreen; gamepad" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        {data.video && <p class="fallback">Build not loading? Watch the video below{data.playUrl && <> or <a href={data.playUrl} rel="noopener" target="_blank">play it on itch.io<span class="sr-only"> (opens in new tab)</span></a></>}.</p>}
      </div>
    )}
    {data.video && (
      <div class="media">
        <div class="video">
          <iframe src={data.video} title={`${data.title} video`} loading="lazy" allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"></iframe>
        </div>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>
    <ul class="tags">{data.tags.map((t) => <li>{t}</li>)}</ul>
  </article>
</BaseLayout>

<script>
  const setTitle = (d: HTMLDetailsElement) => {
    const s = d.querySelector(':scope > summary');
    if (s) s.setAttribute('title', d.open ? 'Click to collapse' : 'Click to expand');
  };
  document.querySelectorAll<HTMLDetailsElement>('.prose details').forEach((d) => {
    setTitle(d);
    d.addEventListener('toggle', () => setTitle(d));
  });

  // Muted loops play only while on screen; with reduced motion they stay paused and get controls.
  const loops = document.querySelectorAll<HTMLVideoElement>('.prose video[autoplay]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  loops.forEach((v) => {
    v.removeAttribute('autoplay');
    v.pause();
    if (reduce) v.controls = true;
  });
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) void v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.25 });
    loops.forEach((v) => io.observe(v));
  }
</script>
