---
import '../styles/global.css';
import { siteConfig } from '../site.config';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
}

const { title, description = siteConfig.description, image, imageAlt, imageWidth, imageHeight, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${siteConfig.ownerName}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

// Path relative to `base`, without trailing slash ('/' for home).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = (Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(/\/+$/, '') || '/';
const projectsCurrent = rel === '/' ? 'page' : rel.startsWith('/projects') ? 'true' : undefined;
const aboutCurrent = rel === '/about' ? 'page' : rel.startsWith('/about/') ? 'true' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {ogImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>{siteConfig.ownerName}</a>
        <nav aria-label="Main">
          <ul class="nav">
            <li><a href={url('/#projects')} aria-current={projectsCurrent}>Projects</a></li>
            <li><a href={url('/about')} aria-current={aboutCurrent}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} {siteConfig.ownerName}</p>
        <ul class="nav">
          <li><a href={`mailto:${siteConfig.email}`}>Email</a></li>
          <li><a href={siteConfig.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a href={siteConfig.itch} rel="noopener" target="_blank">itch.io<span class="sr-only"> (opens in new tab)</span></a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
