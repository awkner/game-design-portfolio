---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { siteConfig } from '../site.config';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
}

const { title, description = siteConfig.description, image, imageAlt, imageWidth, imageHeight, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${siteConfig.ownerName}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? (siteConfig.ogImage.startsWith('/') ? url(siteConfig.ogImage) : siteConfig.ogImage), Astro.site);
const ogAlt = image ? imageAlt : siteConfig.name;
const ogW = image ? imageWidth : 1200;
const ogH = image ? imageHeight : 630;
const [uy, um] = siteConfig.lastUpdated.split('-').map(Number);
const updated = new Date(Date.UTC(uy, um - 1, 1)).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

// Path relative to `base`, without trailing slash ('/' for home).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = (Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(/\/+$/, '') || '/';
const projectsCurrent = rel === '/' ? 'page' : rel.startsWith('/projects') ? 'true' : undefined;
const experienceCurrent = rel === '/experience' ? 'page' : undefined;
const aboutCurrent = rel === '/about' ? 'page' : rel.startsWith('/about/') ? 'true' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {ogW && <meta property="og:image:width" content={String(ogW)} />}
    {ogH && <meta property="og:image:height" content={String(ogH)} />}
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>{siteConfig.ownerName}</a>
        <nav aria-label="Main">
          <ul class="nav">
            <li><a href={url('/#projects')} aria-current={projectsCurrent}>Projects</a></li>
            <li><a href={url('/experience')} aria-current={experienceCurrent}>Experience</a></li>
            <li><a href={url('/about')} aria-current={aboutCurrent}>About</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer" id="contact">
      <div class="container footer-inner">
        <div>
          <p>Contact: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
          <p class="updated">&copy; {new Date().getFullYear()} {siteConfig.ownerName} &middot; Last updated {updated}</p>
        </div>
        <ul class="nav">
          <li><a href={siteConfig.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a href={siteConfig.artstation} rel="noopener" target="_blank">ArtStation<span class="sr-only"> (opens in new tab)</span></a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
